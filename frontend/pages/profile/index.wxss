.profile-page {
  min-height: 100vh;
  background-color: var(--secondary-color);
  padding-bottom: 100rpx;
}

.page-header {
  background: white;
  padding: 30rpx 40rpx;
  box-shadow: var(--shadow-sm);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.loading-wrapper {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-light);
}

.content {
  padding: 30rpx;
}

/* 用户信息卡片 */
.user-card {
  background: white;
  border-radius: var(--border-radius-lg);
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.user-avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--secondary-color);
  border: 4rpx solid white;
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.user-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.edit-btn-wrapper {
  display: flex;
  align-items: center;
}

.edit-btn {
  background-color: var(--primary-color);
  color: white;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  border-radius: var(--border-radius-md);
}

/* 统计概览 */
.stats-overview {
  background: white;
  border-radius: var(--border-radius-lg);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 25rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: var(--secondary-color);
  border-radius: var(--border-radius-md);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-dark);
  margin-bottom: 10rpx;
}

.stat-value.price {
  color: var(--accent-color);
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 功能列表 */
.menu-list {
  background: white;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.logout-text {
  color: var(--error-color);
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-light);
}

/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.modal-content {
  width: 90%;
  max-height: 85%;
  background: white;
  border-radius: var(--border-radius-xl);
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.modal-close {
  font-size: 50rpx;
  color: var(--text-light);
  line-height: 1;
  padding: 0 10rpx;
}

.modal-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--secondary-color);
  border: 1rpx solid transparent;
  border-radius: var(--border-radius-md);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.3s;
}

.form-input:focus {
  background: white;
  border-color: var(--primary-color);
}

.avatar-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-option {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  padding: 4rpx;
  cursor: pointer;
}

.avatar-option.selected {
  border-color: var(--primary-color);
}

.avatar-option image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.modal-footer {
  display: flex;
  gap: 30rpx;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid var(--border-color);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--border-radius-md);
  font-size: 30rpx;
  font-weight: bold;
}

.cancel-btn {
  background-color: var(--secondary-color);
  color: var(--text-secondary);
}

.confirm-btn {
  background-color: var(--primary-color);
  color: white;
}



