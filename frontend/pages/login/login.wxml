<view class="login-page">
  <!-- Background Decorations -->
  <view class="bg-decoration circle-1"></view>
  <view class="bg-decoration circle-2"></view>

  <!-- Milk Tea Image -->
  <view class="milk-tea-img-container">
    <image src="/public/奶茶.jpg" class="milk-tea-img" mode="widthFix" />
  </view>

  <view class="auth-card">
    <view class="card-header">
      <text class="title">今天你喝奶茶了吗</text>
    </view>

    <view class="form-section">
      <view class="tab-bar">
        <text class="tab {{isLogin ? 'active' : ''}}" bindtap="toggleMode">登录</text>
        <text class="tab {{!isLogin ? 'active' : ''}}" bindtap="toggleMode">注册</text>
      </view>

      <view class="form">
        <!-- 登录模式：手机号 + 密码 -->
        <block wx:if="{{isLogin}}">
          <view class="form-group">
            <text class="label">手机号</text>
            <input
              class="input"
              placeholder="请输入手机号"
              placeholder-style="color:#999;font-weight:normal;"
              type="number"
              value="{{phone}}"
              bindinput="onPhoneInput"
              maxlength="11"
            />
          </view>
          <view class="form-group">
            <text class="label">密码</text>
            <input
              class="input"
              placeholder="请输入密码"
              placeholder-style="color:#999;font-weight:normal;"
              password
              value="{{password}}"
              bindinput="onPasswordInput"
              maxlength="25"
            />
          </view>
        </block>

        <!-- 注册模式：用户名 + 手机号 + 密码 -->
        <block wx:else>
          <view class="form-group">
            <text class="label">用户名</text>
            <input
              class="input"
              placeholder="请输入用户名（3-25位）"
              placeholder-style="color:#999;font-weight:normal;"
              value="{{username}}"
              bindinput="onUsernameInput"
              maxlength="25"
            />
          </view>
          <view class="form-group">
            <text class="label">手机号</text>
            <input
              class="input"
              placeholder="请输入手机号"
              placeholder-style="color:#999;font-weight:normal;"
              type="number"
              value="{{phone}}"
              bindinput="onPhoneInput"
              maxlength="11"
            />
          </view>
          <view class="form-group">
            <text class="label">密码</text>
            <input
              class="input"
              placeholder="请输入密码（6-25位，含字母数字）"
              placeholder-style="color:#999;font-weight:normal;"
              password
              value="{{password}}"
              bindinput="onPasswordInput"
              maxlength="25"
            />
          </view>
        </block>

        <button
          class="submit-btn"
          type="primary"
          loading="{{loading}}"
          bindtap="handleSubmit"
        >
          {{isLogin ? '登录' : '注册'}}
        </button>

        <view class="quick-login">
          <text class="quick-login-text" bindtap="quickLogin">快速测试登录</text>
        </view>
      </view>
    </view>
  </view>
</view>
