.login-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--secondary-color);
  position: relative;
  overflow: hidden;
}

/* Background Circles */
.bg-decoration {
  position: absolute;
  border-radius: 50%;
  opacity: 0.6;
  z-index: 0;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  background: #FDE8D0;
  top: -200rpx;
  right: -100rpx;
}

.circle-2 {
  width: 400rpx;
  height: 400rpx;
  background: #E8D5C0;
  bottom: -100rpx;
  left: -100rpx;
}

/* Milk Tea Image */
.milk-tea-img-container {
  position: absolute;
  left: 5%;
  bottom: 10%;
  z-index: 5;
  width: 240rpx;
  height: auto;
  animation: float 3s ease-in-out infinite;
}

.milk-tea-img {
  width: 100%;
  height: auto;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
  transform: rotate(-5deg);
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

/* Auth Card */
.auth-card {
  background: white;
  padding: 60rpx 50rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-lg);
  width: 85%;
  max-width: 600rpx;
  z-index: 10;
  position: relative;
  text-align: center;
}

.card-header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tab-bar {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 50rpx;
}

.tab {
  font-size: 32rpx;
  color: var(--text-light);
  padding-bottom: 10rpx;
  position: relative;
}

.tab.active {
  color: var(--primary-color);
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  border: 2rpx solid transparent;
  background-color: var(--secondary-color);
  border-radius: var(--border-radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--primary-color);
  background-color: white;
}

.submit-btn {
  height: 90rpx;
  line-height: 90rpx;
  background: #8B4513; /* 深棕色 */
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  margin-top: 20rpx;
  box-shadow: var(--shadow-md);
}

.quick-login {
  text-align: center;
  margin-top: 20rpx;
}

.quick-login-text {
  font-size: 26rpx;
  color: var(--primary-color);
  text-decoration: underline;
}

