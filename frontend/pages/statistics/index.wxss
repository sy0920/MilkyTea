.statistics-page {
  min-height: 100vh;
  background-color: var(--secondary-color);
  padding-bottom: 100rpx;
}

.page-header {
  background: white;
  padding: 30rpx 40rpx;
  box-shadow: var(--shadow-sm);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.loading-wrapper {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-light);
}

.content {
  padding: 30rpx;
}

/* 统计摘要卡片 */
.summary-card {
  background: white;
  border-radius: var(--border-radius-lg);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.summary-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 25rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 20rpx;
  background: var(--secondary-color);
  border-radius: var(--border-radius-md);
}

.summary-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-dark);
  margin-bottom: 10rpx;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.price-color {
  color: var(--accent-color) !important;
}

/* 统计卡片 */
.stats-card {
  background: white;
  border-radius: var(--border-radius-lg);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 25rpx;
}

/* 品牌列表 */
.brand-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.brand-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--secondary-color);
  border-radius: var(--border-radius-md);
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e0e0e0;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.rank-number.top-rank {
  background: var(--warning-color);
}

.brand-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.brand-logo-small {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid white;
}

.brand-name-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.brand-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.stat-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 红黑榜列表 */
.rating-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rating-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-radius: var(--border-radius-md);
}

.rating-item.top-rated {
  background: rgba(42, 157, 143, 0.1); /* success-color with opacity */
  border-left: 6rpx solid var(--success-color);
}

.rating-item.low-rated {
  background: rgba(231, 111, 81, 0.1); /* error-color with opacity */
  border-left: 6rpx solid var(--error-color);
}

.rating-info {
  display: flex;
  flex-direction: column;
}

.rating-brand {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.rating-category {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.rating-score {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-dark);
}

/* 近期记录列表 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--secondary-color);
  border-radius: var(--border-radius-md);
}

.recent-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.recent-brand {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.recent-category {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.recent-date {
  font-size: 22rpx;
  color: var(--text-light);
}

.recent-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--accent-color);
}

/* 近期记录列表 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--secondary-color);
  border-radius: var(--border-radius-md);
}

.recent-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.recent-brand {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.recent-category {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.recent-date {
  font-size: 22rpx;
  color: var(--text-light);
}

.recent-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--accent-color);
}

/* 空状态 */
.empty-wrapper {
  text-align: center;
  padding: 150rpx 0;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: var(--text-light);
}



